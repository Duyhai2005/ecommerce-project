# App
NODE_ENV=development
APP_PORT=3000
API_PORT=5000

# Database
DATABASE_URL=mysql+asyncmy://ecommerce_user:ecommerce_password@localhost:3307/ecommerce_db
ASYNC_DATABASE_URL=mysql+asyncmy://ecommerce_user:ecommerce_password@localhost:3307/ecommerce_db

# Auth
JWT_SECRET=change_me

# Email verification SMTP
# For Gmail, use an App Password, not your normal account password.
DEV_AUTH_DEBUG=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Shepoo
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_VERIFYCATION_TOKEN_EXPIRE_MINUTES=10
